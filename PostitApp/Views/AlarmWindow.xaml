<Window x:Class="PostitApp.Views.AlarmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TopApp Memo — Configurar Alarma"
        Icon="/Assets/Icons/app.ico"
        Width="420" Height="520"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Grid Margin="12">
        <!-- Sombra externa de la tarjeta -->
        <Border CornerRadius="18" Background="#1E293B">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.35" Color="#000000"/>
            </Border.Effect>
        </Border>

        <!-- Contenedor principal -->
        <Border CornerRadius="18" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="64"/>
                </Grid.RowDefinitions>

                <!-- Cabecera -->
                <Border Grid.Row="0" Background="#1E293B" Padding="18,0" MouseLeftButtonDown="Header_MouseLeftButtonDown" Cursor="SizeAll">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconBellGeo}" Fill="#F59E0B" Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0"/>
                            <TextBlock Text="Configurar Alarma" FontSize="15" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Style="{StaticResource BtnHeaderDanger}" HorizontalAlignment="Right" Click="BtnCerrar_Click" ToolTip="Cerrar">
                            <Path Data="{StaticResource IconCloseGeo}" Stroke="#94A3B8" StrokeThickness="1.8" Width="10" Height="10" Stretch="Uniform"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Contenido -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,16">
                    <StackPanel>
                        <!-- Presets rápidos -->
                        <TextBlock Text="ACCESOS RÁPIDOS" FontSize="10.5" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,8"/>
                        <WrapPanel Margin="0,0,0,16">
                            <Button Content="+15 min" Tag="15" Click="Preset_Click" Style="{StaticResource BtnSecondaryModern}" Foreground="#CBD5E1" Margin="0,0,6,6"/>
                            <Button Content="+30 min" Tag="30" Click="Preset_Click" Style="{StaticResource BtnSecondaryModern}" Foreground="#CBD5E1" Margin="0,0,6,6"/>
                            <Button Content="+1 hora" Tag="60" Click="Preset_Click" Style="{StaticResource BtnSecondaryModern}" Foreground="#CBD5E1" Margin="0,0,6,6"/>
                            <Button Content="+3 horas" Tag="180" Click="Preset_Click" Style="{StaticResource BtnSecondaryModern}" Foreground="#CBD5E1" Margin="0,0,6,6"/>
                            <Button Content="Mañana 09:00" Tag="tomorrow" Click="Preset_Click" Style="{StaticResource BtnSecondaryModern}" Foreground="#CBD5E1" Margin="0,0,6,6"/>
                        </WrapPanel>

                        <!-- Fecha -->
                        <TextBlock Text="FECHA" FontSize="10.5" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,6"/>
                        <DatePicker x:Name="DpFecha" FontSize="13" Background="#1E293B" Foreground="#F8FAFC" BorderBrush="#334155" Margin="0,0,0,14"/>

                        <!-- Hora y Minuto -->
                        <TextBlock Text="HORA Y MINUTOS" FontSize="10.5" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="10,6">
                                <TextBox x:Name="TxtHora" Text="12" FontSize="18" FontWeight="Bold" HorizontalContentAlignment="Center" Background="Transparent" Foreground="#F8FAFC" BorderThickness="0"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text=":" FontSize="20" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border Grid.Column="2" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="10,6">
                                <TextBox x:Name="TxtMinuto" Text="00" FontSize="18" FontWeight="Bold" HorizontalContentAlignment="Center" Background="Transparent" Foreground="#F8FAFC" BorderThickness="0"/>
                            </Border>
                        </Grid>

                        <!-- Duración -->
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="DURACIÓN DEL AVISO" FontSize="10.5" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="LblDuracion" Text="10 segundos" FontSize="11" Foreground="#F59E0B" HorizontalAlignment="Right"/>
                        </Grid>
                        <Slider x:Name="SliderDuracion" Minimum="5" Maximum="60" Value="10" ValueChanged="SliderDuracion_ValueChanged" Margin="0,0,0,16"/>

                        <!-- Sonido -->
                        <TextBlock Text="SONIDO DE LA ALARMA" FontSize="10.5" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,6"/>
                        <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="10,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="LblSonido" Text="Sonido del sistema" FontSize="12" Foreground="#CBD5E1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <Button Grid.Column="1" Content="Probar" Click="BtnProbarSonido_Click" Style="{StaticResource BtnSecondaryModern}" Foreground="#CBD5E1" Margin="8,0,0,0"/>
                                <Button Grid.Column="2" Content="Examinar..." Click="BtnElegirSonido_Click" Style="{StaticResource BtnSecondaryModern}" Foreground="#CBD5E1" Margin="6,0,0,0"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Pie de página con botones -->
                <Border Grid.Row="2" Background="#1E293B" Padding="18,0">
                    <Grid VerticalAlignment="Center">
                        <Button Content="Cancelar" Click="BtnCerrar_Click" Style="{StaticResource BtnSecondaryModern}" HorizontalAlignment="Left" Foreground="#94A3B8" Padding="16,8"/>
                        <Button Content="Activar Alarma" Click="BtnActivar_Click" Style="{StaticResource BtnPrimaryModern}" HorizontalAlignment="Right" Padding="20,8"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
