<Window x:Class="PostitApp.Views.ManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PostitApp.ViewModels"
        Title="{DynamicResource Str_ManagerTitle}"
        Icon="/Assets/Icons/app.ico"
        Width="980" Height="650"
        MinWidth="820" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!-- Botón de acción para cada tarjeta de nota -->
        <Style x:Key="BtnCardAction" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="borde"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="borde" Property="Background" Value="#14000000"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="borde" Property="Background" Value="#22000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnCardActionDanger" TargetType="Button" BasedOn="{StaticResource BtnCardAction}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="borde"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="borde" Property="Background" Value="#FFF1F2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="borde" Property="Background" Value="#FFE4E6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón chip de filtro -->
        <Style x:Key="BtnFilterChip" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="borde"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="borde" Property="Background" Value="#E2E8F0"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Barra superior Slate -->
            <RowDefinition Height="Auto"/> <!-- Barra de búsqueda y filtros -->
            <RowDefinition Height="*"/>    <!-- Rejilla de notas -->
            <RowDefinition Height="Auto"/> <!-- Pie de página -->
        </Grid.RowDefinitions>

        <!-- ==================== 1. CABECERA MODERNA ==================== -->
        <Border Grid.Row="0" Background="#0F172A" Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- Logo y Título -->
                    <ColumnDefinition Width="*"/>    <!-- Métricas -->
                    <ColumnDefinition Width="Auto"/> <!-- Acciones -->
                </Grid.ColumnDefinitions>

                <!-- Identidad de la App -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/Icons/app.png"
                           Width="42" Height="42"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Margin="0,0,12,0"
                           VerticalAlignment="Center">
                        <Image.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.4" Color="#000000"/>
                        </Image.Effect>
                    </Image>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="TopApp Memo" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <Border Background="#334155" CornerRadius="4" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="v2.0" FontSize="10" FontWeight="Bold" Foreground="#F59E0B"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{DynamicResource Str_AppSubtitle}" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Tarjetas de Métricas -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8,0">
                    <!-- Total -->
                    <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="8,5" Margin="2,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource Str_Total}" FontSize="11" Foreground="#94A3B8"/>
                            <TextBlock Text="{Binding TotalNotas}" FontSize="12" FontWeight="Bold" Foreground="#F8FAFC"/>
                        </StackPanel>
                    </Border>
                    <!-- Visibles -->
                    <Border Background="#1E293B" BorderBrush="#10B981" BorderThickness="1" CornerRadius="8" Padding="8,5" Margin="2,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="#10B981" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Str_Visibles}" FontSize="11" Foreground="#94A3B8"/>
                            <TextBlock Text="{Binding NotasVisibles}" FontSize="12" FontWeight="Bold" Foreground="#10B981"/>
                        </StackPanel>
                    </Border>
                    <!-- Ocultas -->
                    <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="8,5" Margin="2,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource Str_Ocultas}" FontSize="11" Foreground="#94A3B8"/>
                            <TextBlock Text="{Binding NotasOcultas}" FontSize="12" FontWeight="Bold" Foreground="#CBD5E1"/>
                        </StackPanel>
                    </Border>
                    <!-- Con Audio -->
                    <Border Background="#1E293B" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="8" Padding="8,5" Margin="2,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconMicGeo}" Fill="#3B82F6" Width="10" Height="10" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Str_Audio}" FontSize="11" Foreground="#94A3B8"/>
                            <TextBlock Text="{Binding NotasConAudio}" FontSize="12" FontWeight="Bold" Foreground="#3B82F6"/>
                        </StackPanel>
                    </Border>
                    <!-- Con Alarma -->
                    <Border Background="#1E293B" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="8" Padding="8,5" Margin="2,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconBellGeo}" Fill="#F59E0B" Width="10" Height="10" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Str_Alarma}" FontSize="11" Foreground="#94A3B8"/>
                            <TextBlock Text="{Binding NotasConAlarma}" FontSize="12" FontWeight="Bold" Foreground="#F59E0B"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Acciones Principales -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Selector de Idioma (ES / EN) -->
                    <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="3" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="ES"
                                    Command="{Binding CambiarIdiomaCmd}"
                                    CommandParameter="es"
                                    Width="28" Height="24"
                                    FontSize="11" FontWeight="Bold"
                                    Cursor="Hand" BorderThickness="0">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="#94A3B8"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSpanish}" Value="True">
                                                <Setter Property="Background" Value="#3B82F6"/>
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button Content="EN"
                                    Command="{Binding CambiarIdiomaCmd}"
                                    CommandParameter="en"
                                    Width="28" Height="24"
                                    FontSize="11" FontWeight="Bold"
                                    Cursor="Hand" BorderThickness="0"
                                    Margin="2,0,0,0">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="#94A3B8"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEnglish}" Value="True">
                                                <Setter Property="Background" Value="#3B82F6"/>
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Button Style="{StaticResource BtnSecondaryModern}"
                            Foreground="#CBD5E1"
                            BorderBrush="#334155"
                            Background="#1E293B"
                            Margin="0,0,10,0"
                            Command="{Binding HelpCmd}"
                            ToolTip="{DynamicResource Str_AyudaTooltip}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconHelpGeo}" Fill="#38BDF8" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Str_Ayuda}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Content="{DynamicResource Str_GuardarTodo}"
                            Style="{StaticResource BtnSecondaryModern}"
                            Foreground="#CBD5E1"
                            BorderBrush="#334155"
                            Background="#1E293B"
                            Margin="0,0,10,0"
                            Command="{Binding GuardarTodasCmd}"
                            ToolTip="{DynamicResource Str_GuardarTodoTooltip}"/>
                    <Button Content="{DynamicResource Str_NuevaNota}"
                            Style="{StaticResource BtnPrimaryModern}"
                            Padding="18,8"
                            Command="{Binding NuevaNotaCmd}"
                            ToolTip="{DynamicResource Str_NuevaNotaTooltip}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 2. BARRA DE BÚSQUEDA Y FILTROS ==================== -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Caja de Búsqueda -->
                <Border Grid.Column="0" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10" Padding="10,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Path Grid.Column="0" Data="{StaticResource IconSearchGeo}" Stroke="#94A3B8" StrokeThickness="1.5" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>

                        <!-- Placeholder -->
                        <TextBlock Grid.Column="1" Text="{DynamicResource Str_BuscarNotas}" Foreground="#94A3B8" FontSize="12.5" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TextoBusqueda}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBox Grid.Column="1" Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" BorderThickness="0" FontSize="12.5" Foreground="#0F172A" VerticalAlignment="Center"/>

                        <!-- Botón limpiar -->
                        <Button Grid.Column="2" Width="20" Height="20" Command="{Binding LimpiarBusquedaCmd}" ToolTip="Limpiar búsqueda">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource BtnCardAction}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TextoBusqueda}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Path Data="{StaticResource IconCloseGeo}" Stroke="#94A3B8" StrokeThickness="1.5" Width="8" Height="8" Stretch="Uniform"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Chips de Categoría / Filtros -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <Button Content="{DynamicResource Str_FiltroTodas}" Style="{StaticResource BtnFilterChip}" Command="{Binding FiltrarCmd}" CommandParameter="todas"/>
                    <Button Content="{DynamicResource Str_FiltroVisibles}" Style="{StaticResource BtnFilterChip}" Command="{Binding FiltrarCmd}" CommandParameter="visibles"/>
                    <Button Content="{DynamicResource Str_FiltroOcultas}" Style="{StaticResource BtnFilterChip}" Command="{Binding FiltrarCmd}" CommandParameter="ocultas"/>
                    <Button Content="{DynamicResource Str_FiltroAudio}" Style="{StaticResource BtnFilterChip}" Command="{Binding FiltrarCmd}" CommandParameter="audio"/>
                    <Button Content="{DynamicResource Str_FiltroAlarma}" Style="{StaticResource BtnFilterChip}" Command="{Binding FiltrarCmd}" CommandParameter="alarma"/>
                </StackPanel>

                <!-- Botones Mostrar/Ocultar Todas -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{DynamicResource Str_MostrarTodas}" Style="{StaticResource BtnSecondaryModern}" Margin="0,0,6,0" Command="{Binding MostrarTodasCmd}"/>
                    <Button Content="{DynamicResource Str_OcultarTodas}" Style="{StaticResource BtnSecondaryModern}" Command="{Binding OcultarTodasCmd}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 3. REJILLA DE TARJETAS DE NOTAS ==================== -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20">
            <Grid>
                <!-- Lista de Notas -->
                <ItemsControl ItemsSource="{Binding Notas}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Tarjeta de Nota Flotante -->
                            <Border Width="195" Height="240" Margin="10"
                                    Background="#FFFFFF"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1"
                                    CornerRadius="16">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.08" Color="#000000"/>
                                </Border.Effect>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/> <!-- Tira superior color y badges -->
                                        <RowDefinition Height="*"/>    <!-- Vista previa de texto -->
                                        <RowDefinition Height="Auto"/> <!-- Barra de acciones -->
                                    </Grid.RowDefinitions>

                                    <!-- Tira de color y estado -->
                                    <Border Grid.Row="0" CornerRadius="16,16,0,0" Background="{Binding BrushCabecera}" Padding="10,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/> <!-- Estado (Visible / Oculta) -->
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/> <!-- Badges -->
                                            </Grid.ColumnDefinitions>

                                            <!-- Estado -->
                                            <Border Grid.Column="0" CornerRadius="6" Padding="6,2">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding EsVisible}" Value="True">
                                                                <Setter Property="Background" Value="#DCFCE7"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding EsVisible}" Value="False">
                                                                <Setter Property="Background" Value="#F1F5F9"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontSize="9.5" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding EsVisible}" Value="True">
                                                                    <Setter Property="Text" Value="En Escritorio"/>
                                                                    <Setter Property="Foreground" Value="#15803D"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding EsVisible}" Value="False">
                                                                    <Setter Property="Text" Value="Oculta"/>
                                                                    <Setter Property="Foreground" Value="#64748B"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>

                                            <!-- Badges de características -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                <!-- Audio badge -->
                                                <Border Background="#DBEAFE" CornerRadius="4" Padding="4,1" Margin="2,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding TieneAudio}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Path Data="{StaticResource IconMicGeo}" Fill="#2563EB" Width="9" Height="9" Stretch="Uniform" ToolTip="Tiene mensaje de voz grabado"/>
                                                </Border>

                                                <!-- Alarma badge -->
                                                <Border Background="#FEF3C7" CornerRadius="4" Padding="4,1" Margin="2,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding TieneAlarma}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Path Data="{StaticResource IconBellGeo}" Fill="#D97706" Width="9" Height="9" Stretch="Uniform" ToolTip="{Binding TextoAlarma}"/>
                                                </Border>

                                                <!-- Pin badge -->
                                                <Border Background="#F1F5F9" CornerRadius="4" Padding="4,1" Margin="2,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SiempreAlFrente}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Path Data="{StaticResource IconPinGeo}" Fill="#64748B" Width="9" Height="9" Stretch="Uniform" ToolTip="Siempre al frente"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Cuerpo con Vista previa del texto -->
                                    <Border Grid.Row="1" Background="{Binding BrushFondo}" Padding="12,10" Cursor="Hand">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding DataContext.AbrirNotaCmd, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                          CommandParameter="{Binding}"/>
                                        </Border.InputBindings>
                                        <Grid>
                                            <TextBlock Text="{Binding TextoPlano}"
                                                       FontSize="11.5"
                                                       FontFamily="{Binding Fuente}"
                                                       Foreground="#1E293B"
                                                       TextWrapping="Wrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxHeight="100"
                                                       LineHeight="16"
                                                       VerticalAlignment="Top"/>

                                            <!-- Fecha de modificación -->
                                            <TextBlock VerticalAlignment="Bottom" HorizontalAlignment="Left"
                                                       FontSize="9.5" Foreground="#94A3B8"
                                                       Text="{Binding FechaModificacion, StringFormat='{}{0:dd/MM/yy HH:mm}'}"/>
                                        </Grid>
                                    </Border>

                                    <!-- Barra inferior de acciones (botones actualizados) -->
                                    <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#F1F5F9" BorderThickness="0,1,0,0" CornerRadius="0,0,16,16" Padding="6,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- 1. Abrir en escritorio -->
                                            <Button Grid.Column="0" Style="{StaticResource BtnCardAction}" ToolTip="Abrir / Traer al frente"
                                                    Command="{Binding DataContext.AbrirNotaCmd, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <Path Data="{StaticResource IconEyeGeo}" Stroke="#475569" StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform"/>
                                            </Button>

                                            <!-- 2. Reproducir Audio Preview -->
                                            <Button Grid.Column="1" ToolTip="Escuchar mensaje de voz"
                                                    Command="{Binding DataContext.ReproducirAudioPreviewCmd, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource BtnCardAction}">
                                                        <Setter Property="Opacity" Value="0.25"/>
                                                        <Setter Property="IsEnabled" Value="False"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding TieneAudio}" Value="True">
                                                                <Setter Property="Opacity" Value="1.0"/>
                                                                <Setter Property="IsEnabled" Value="True"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <Path Data="{StaticResource IconPlayGeo}" Fill="#3B82F6" Width="12" Height="12" Stretch="Uniform"/>
                                            </Button>

                                            <!-- 3. Toggle Visibilidad (Mostrar / Ocultar) -->
                                            <Button Grid.Column="2" Style="{StaticResource BtnCardAction}" ToolTip="Alternar visibilidad"
                                                    Command="{Binding DataContext.ToggleVisibilidadCmd, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <Path Data="{StaticResource IconEyeOffGeo}" Stroke="#64748B" StrokeThickness="1.4" Width="14" Height="14" Stretch="Uniform"/>
                                            </Button>

                                            <!-- 4. Eliminar Nota -->
                                            <Button Grid.Column="3" Style="{StaticResource BtnCardActionDanger}" ToolTip="Eliminar definitivamente"
                                                    Command="{Binding DataContext.EliminarNotaCmd, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <Path Data="{StaticResource IconTrashGeo}" Stroke="#EF4444" StrokeThickness="1.4" Width="13" Height="13" Stretch="Uniform"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Estado Vacío (si no hay notas) -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,60,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HayNotas}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <Border Width="64" Height="64" Background="#F1F5F9" CornerRadius="32" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <Path Data="{StaticResource IconSearchGeo}" Stroke="#94A3B8" StrokeThickness="2" Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="No se encontraron notas" FontSize="16" FontWeight="SemiBold" Foreground="#334155" HorizontalAlignment="Center"/>
                    <TextBlock Text="Prueba con otra búsqueda o crea una nueva nota adhesiva." FontSize="12.5" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,4,0,16"/>
                    <Button Content="+ Crear nueva nota" Style="{StaticResource BtnPrimaryModern}" HorizontalAlignment="Center" Command="{Binding NuevaNotaCmd}"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- ==================== 4. PIE DE PÁGINA ==================== -->
        <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="24,10">
            <Grid>
                <TextBlock FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Left"
                           Text="{DynamicResource Str_PieCreditos}"/>
                <TextBlock FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Right"
                           Text="{DynamicResource Str_PieAutoguardado}"/>
            </Grid>
        </Border>
    </Grid>
</Window>