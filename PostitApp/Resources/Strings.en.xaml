<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Language Metadata -->
    <sys:String x:Key="Lang_Code">en</sys:String>
    <sys:String x:Key="Lang_Name">English</sys:String>

    <!-- General / Header -->
    <sys:String x:Key="Str_AppTitle">TopApp Memo</sys:String>
    <sys:String x:Key="Str_AppSubtitle">by Tomas Folgado • Quick Notes for Windows</sys:String>
    <sys:String x:Key="Str_ManagerTitle">TopApp Memo — Control Panel</sys:String>

    <!-- Metrics -->
    <sys:String x:Key="Str_Total">Total: </sys:String>
    <sys:String x:Key="Str_Visibles">Visible: </sys:String>
    <sys:String x:Key="Str_Ocultas">Hidden: </sys:String>
    <sys:String x:Key="Str_Audio">Audio: </sys:String>
    <sys:String x:Key="Str_Alarma">Alarm: </sys:String>

    <!-- Header Actions -->
    <sys:String x:Key="Str_Ayuda">Help</sys:String>
    <sys:String x:Key="Str_AyudaTooltip">Help Center &amp; Shortcuts</sys:String>
    <sys:String x:Key="Str_GuardarTodo">Save All</sys:String>
    <sys:String x:Key="Str_GuardarTodoTooltip">Save all notes to disk</sys:String>
    <sys:String x:Key="Str_NuevaNota">+ New Note</sys:String>
    <sys:String x:Key="Str_NuevaNotaTooltip">Create a new sticky note</sys:String>

    <!-- Search & Filter Bar -->
    <sys:String x:Key="Str_BuscarNotas">Search notes...</sys:String>
    <sys:String x:Key="Str_FiltroTodas">All</sys:String>
    <sys:String x:Key="Str_FiltroVisibles">Visible</sys:String>
    <sys:String x:Key="Str_FiltroOcultas">Hidden</sys:String>
    <sys:String x:Key="Str_FiltroAudio">With Audio</sys:String>
    <sys:String x:Key="Str_FiltroAlarma">With Alarm</sys:String>
    <sys:String x:Key="Str_MostrarTodas">Show All</sys:String>
    <sys:String x:Key="Str_OcultarTodas">Hide All</sys:String>

    <!-- Note Cards -->
    <sys:String x:Key="Str_CardMostrar">Show note</sys:String>
    <sys:String x:Key="Str_CardOcultar">Hide note</sys:String>
    <sys:String x:Key="Str_CardAudioPlay">Play audio</sys:String>
    <sys:String x:Key="Str_CardAudioStop">Stop audio</sys:String>
    <sys:String x:Key="Str_CardDuplicar">Duplicate note</sys:String>
    <sys:String x:Key="Str_CardEliminar">Delete note</sys:String>
    <sys:String x:Key="Str_CardEstadoVisible">Visible</sys:String>
    <sys:String x:Key="Str_CardEstadoOculta">Hidden</sys:String>
    <sys:String x:Key="Str_CardSinTexto">(Empty note)</sys:String>

    <!-- Footer -->
    <sys:String x:Key="Str_PieAutoguardado">Auto-save enabled</sys:String>
    <sys:String x:Key="Str_PieCreditos">TopApp Memo v2.0 • Autonomous Audio • Modern Design</sys:String>

    <!-- Dialogs C# -->
    <sys:String x:Key="Str_MsgEliminarTitulo">TopApp Memo — Delete Note</sys:String>
    <sys:String x:Key="Str_MsgEliminarPregunta">Are you sure you want to permanently delete this note?</sys:String>
    <sys:String x:Key="Str_MsgGuardadas">All notes have been saved successfully.</sys:String>

    <!-- Help Window -->
    <sys:String x:Key="Str_HelpWinTitle">TopApp Memo — Help Center</sys:String>
    <sys:String x:Key="Str_HelpHeaderTitle">Help Center &amp; User Guide</sys:String>
    <sys:String x:Key="Str_HelpHeaderSubtitle">Discover all features, shortcuts and tips for TopApp Memo</sys:String>
    <sys:String x:Key="Str_HelpSec1Title">Note &amp; Screen Management</sys:String>
    <sys:String x:Key="Str_HelpSec1Item1">Create new note: Click + New Note in the Control Panel or the + button on any note.</sys:String>
    <sys:String x:Key="Str_HelpSec1Item2">Always on Top (Pin): Click the pin icon to keep the note floating on top of all other windows.</sys:String>
    <sys:String x:Key="Str_HelpSec1Item3">Hide and Restore: Hide notes to declutter your desktop without deleting them; restore them anytime from the Control Panel.</sys:String>
    <sys:String x:Key="Str_HelpSec1Item4">Move &amp; Resize: Drag the note by its top header. Resize by dragging the bottom-right corner.</sys:String>

    <sys:String x:Key="Str_HelpSec2Title">Colors, Formatting &amp; Freehand Drawing</sys:String>
    <sys:String x:Key="Str_HelpSec2Item1">8 Sticky Note Colors: Choose between Yellow, Blue, Green, Red, Purple, Orange, Cyan, or White.</sys:String>
    <sys:String x:Key="Str_HelpSec2Item2">Opacity &amp; Intensity: Adjust window transparency and color intensity.</sys:String>
    <sys:String x:Key="Str_HelpSec2Item3">Ink / Freehand Drawing: Click the pen icon to sketch, draw diagrams, or handwrite notes using digital ink.</sys:String>

    <sys:String x:Key="Str_HelpSec3Title">Voice Notes &amp; Smart Dictation</sys:String>
    <sys:String x:Key="Str_HelpSec3Item1">Record Voice Memo: Record voice clips directly attached to your note.</sys:String>
    <sys:String x:Key="Str_HelpSec3Item2">Playback from Panel: Listen to recorded audio directly from the control panel grid.</sys:String>
    <sys:String x:Key="Str_HelpSec3Item3">Voice Dictation: Speak and the app automatically transcribes your voice into rich text.</sys:String>

    <sys:String x:Key="Str_HelpSec4Title">Scheduled Alarms &amp; Reminders</sys:String>
    <sys:String x:Key="Str_HelpSec4Item1">Set Reminder: Use quick presets (+15 min, +1 hour, Tomorrow) or specify an exact date and time.</sys:String>
    <sys:String x:Key="Str_HelpSec4Item2">Visual &amp; Sound Alerts: Onscreen pop-up alert and notification sound when the timer expires.</sys:String>

    <sys:String x:Key="Str_HelpSec5Title">Keyboard Shortcuts &amp; Productivity</sys:String>
    <sys:String x:Key="Str_HelpKbdNegrita">Bold text formatting</sys:String>
    <sys:String x:Key="Str_HelpKbdCursiva">Italic text formatting</sys:String>
    <sys:String x:Key="Str_HelpKbdSubrayado">Underline text formatting</sys:String>
    <sys:String x:Key="Str_HelpKbdGuardar">Save notes to disk</sys:String>
    <sys:String x:Key="Str_HelpKbdEscape">Close help window or active popup</sys:String>

    <sys:String x:Key="Str_HelpEntendido">Got it!</sys:String>
    <sys:String x:Key="Str_HelpPie">TopApp Memo • Quick notes and reminders for Windows</sys:String>

    <!-- Note Window (NoteWindow) -->
    <sys:String x:Key="Str_NoteNueva">New note</sys:String>
    <sys:String x:Key="Str_NoteOpciones">Options &amp; colors</sys:String>
    <sys:String x:Key="Str_NoteAudio">Voice note / Dictation</sys:String>
    <sys:String x:Key="Str_NoteAlarma">Configure alarm</sys:String>
    <sys:String x:Key="Str_NoteDibujo">Freehand drawing mode</sys:String>
    <sys:String x:Key="Str_NotePin">Pin to top (Always on top)</sys:String>
    <sys:String x:Key="Str_NoteOcultar">Hide note</sys:String>
    <sys:String x:Key="Str_NoteCerrar">Delete note</sys:String>

    <!-- Alarm Window (AlarmWindow) -->
    <sys:String x:Key="Str_AlarmTitle">Configure Alarm</sys:String>
    <sys:String x:Key="Str_AlarmPresets">QUICK PRESETS</sys:String>
    <sys:String x:Key="Str_AlarmFecha">DATE</sys:String>
    <sys:String x:Key="Str_AlarmHora">TIME &amp; MINUTE</sys:String>
    <sys:String x:Key="Str_AlarmDuracion">SOUND DURATION</sys:String>
    <sys:String x:Key="Str_AlarmSonido">ALERT SOUND</sys:String>
    <sys:String x:Key="Str_AlarmBtnExaminar">Browse...</sys:String>
    <sys:String x:Key="Str_AlarmBtnCancelar">Cancel</sys:String>
    <sys:String x:Key="Str_AlarmBtnGuardar">Save Alarm</sys:String>
    <sys:String x:Key="Str_AlarmBtnDesactivar">Disable</sys:String>

</ResourceDictionary>
