    <sys:String x:Key="Str_MostrarTodas">Mostrar Todas</sys:String>
    <sys:String x:Key="Str_OcultarTodas">Ocultar Todas</sys:String>

    <!-- Tarjetas de Notas -->
    <sys:String x:Key="Str_CardMostrar">Mostrar nota</sys:String>
    <sys:String x:Key="Str_CardOcultar">Ocultar nota</sys:String>
